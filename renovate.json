{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>renovatebot/renovatebot"
  ],
  "customDatasources": {
    "claude-code": {
      "defaultRegistryUrlTemplate": "https://downloads.claude.ai/claude-code-releases/stable",
      "format": "plain"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins followed by a '# renovate: datasource=... depName=...' marker on the same line",
      "managerFilePatterns": [
        "/^\\.gitea/workflows/review\\.yml$/",
        "/^scripts/secret-scan\\.sh$/"
      ],
      "matchStrings": [
        "(?<currentValue>\\d+\\.\\d+\\.\\d+)[^\\n]*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)"
      ],
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
